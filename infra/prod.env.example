# Copy to infra/.env on the VPS and fill in. Never commit the real file
# (infra/.env is git-ignored). Generate secrets with: openssl rand -base64 48

# --- Postgres --------------------------------------------------------------
POSTGRES_PASSWORD=

# --- API (read via env_file by the api service) -----------------------------
NODE_ENV=production
API_PORT=4000
API_PUBLIC_URL=https://api.alexandregiraud.tech
WEB_ORIGIN=https://alexandregiraud.tech
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Contact form (Resend) — optional --------------------------------------
# Without these three, POST /contact answers 503 and the web form falls back
# to a mailto link. CONTACT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@alexandregiraud.tech
CONTACT_TO_EMAIL=alexandre.giraud1995@gmail.com

# DATABASE_URL is set by compose.prod.yaml itself (points at the postgres
# service) — do not set it here, it would be ignored anyway.

# --- Umami (mesure d'audience) ----------------------------------------------
# Generer avec openssl rand -hex, surtout pas -base64 : un '/' dans le mot de
# passe casse la chaine de connexion Postgres (deja arrive sur ce VPS).
#   UMAMI_DB_PASSWORD=$(openssl rand -hex 24)
#   UMAMI_APP_SECRET=$(openssl rand -hex 32)
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# --- Web (baked in at image build time, not a secret) -----------------------
NEXT_PUBLIC_API_URL=https://api.alexandregiraud.tech
# Laisser NEXT_PUBLIC_UMAMI_WEBSITE_ID vide tant que le site n'est pas cree
# dans Umami : le suivi ne se charge que si les deux sont renseignes.
NEXT_PUBLIC_UMAMI_SRC=https://analytics.alexandregiraud.tech/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
