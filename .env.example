# Copy to .env and fill in. The apps validate these at startup (Zod) and refuse
# to boot if a required variable is missing or malformed.
# Real .env files are git-ignored — never commit secrets.

# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
# Origin allowed to call the API from the browser (the web app).
WEB_ORIGIN=http://localhost:3000

# PostgreSQL — see infra/ for the local Docker setup (PR #3).
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# JWT signing — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh

# OAuth2 providers — create the apps in each provider's developer console.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where providers redirect back after consent.
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/auth/callback

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
